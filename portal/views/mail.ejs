<%- include('partials/header') %>
<div class="head-row">
  <h1>E-Mail</h1>
  <span class="hint"><%= usage.mailbox %> von <%= limits.mailbox ? limits.mailbox : 'unbegrenzt' %> Postfächern<% if (limits.mailbox_quota_mb) { %> · je <%= limits.mailbox_quota_mb %> MB<% } %></span>
</div>

<h2>Mail-Domains</h2>
<% if (!domains.length) { %>
<p class="empty">Dir sind aktuell keine Mail-Domains zugeordnet.</p>
<% } else { %>
<ul class="plain">
<% domains.forEach(function (d) { %>
<li><%= d.ref_name %><% if (d.state === 'missing') { %> <span class="badge warn">im Panel nicht mehr vorhanden</span><% } %></li>
<% }) %>
</ul>

<% if (limits.mailbox && usage.mailbox >= limits.mailbox) { %>
<h2>Neues Postfach anlegen</h2>
<p class="empty">Postfach-Limit Ihres Pakets erreicht (<%= usage.mailbox %> von <%= limits.mailbox %>).</p>
<% } else { %>
<h2>Neues Postfach anlegen</h2>
<form method="post" action="/mail/boxes" class="inline">
  <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
  <input type="text" name="local" placeholder="Postfachname" required>
  <span>@</span>
  <select name="domain" required>
    <% domains.filter(function (d) { return d.state !== 'missing'; }).forEach(function (d) { %>
    <option value="<%= d.ref_name %>"><%= d.ref_name %></option>
    <% }) %>
  </select>
  <input type="password" name="password" placeholder="Passwort (min. 8 Zeichen)" required minlength="8">
  <button type="submit" class="primary">Anlegen</button>
</form>
<% } %>
<% } %>

<h2>Postfächer</h2>
<% if (!boxes.length) { %>
<p class="empty">Dir sind aktuell keine Postfächer zugeordnet.</p>
<% } else { %>
<table class="res">
<thead><tr><th>Adresse</th><th>Status</th><th></th></tr></thead>
<tbody>
<% boxes.forEach(function (b) { %>
<tr class="<%= b.state === 'missing' ? 'missing' : '' %>">
  <td><%= b.ref_name %></td>
  <td><% if (b.state === 'missing') { %><span class="badge warn">im Panel nicht mehr vorhanden</span><% } else { %><span class="badge on">aktiv</span><% } %></td>
  <td class="actions">
    <% if (b.state !== 'missing') { %>
    <% if (limits.mail_backup) { %><a class="btn" href="/mail/boxes/<%= b.id %>/backups">Sicherungen</a><% } %>
    <form method="post" action="/mail/boxes/<%= b.id %>/password" class="inline">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
      <input type="password" name="password" placeholder="neues Passwort" required minlength="8">
      <button type="submit">Passwort ändern</button>
    </form>
    <% } %>
    <form method="post" action="/mail/boxes/<%= b.id %>/delete" data-delete-address="<%= b.ref_name %>">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
      <input type="hidden" name="confirm_email" value="">
      <button type="submit" class="danger">Löschen</button>
    </form>
  </td>
</tr>
<% }) %>
</tbody>
</table>
<% } %>
<div class="modal-backdrop" id="delete-modal" hidden>
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="delete-modal-title">
    <h2 id="delete-modal-title">Postfach löschen</h2>
    <p>Das Postfach <strong id="delete-modal-address"></strong> wird gelöscht. Vorher wird automatisch eine Sicherung angelegt und 30 Tage lang auf dem Server aufbewahrt.</p>
    <label>Zur Bestätigung die E-Mail-Adresse eingeben
      <input type="text" id="delete-modal-input" autocomplete="off" autocapitalize="off" spellcheck="false">
    </label>
    <div class="modal-actions">
      <button type="button" id="delete-modal-cancel">Abbrechen</button>
      <button type="button" id="delete-modal-confirm" class="danger" disabled>Endgültig löschen</button>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
